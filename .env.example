# GHOST — Supabase deployment config
# Copie ce fichier en .env en local. Sur Render/Railway, mets ces valeurs dans Environment Variables.

# local = JSON local ; auto = Supabase si les clés existent, sinon JSON ; supabase = Supabase strict
GHOST_DB_BACKEND=supabase
GHOST_SUPABASE_STRICT=1

SUPABASE_URL=https://TON-PROJET.supabase.co
# Utilise la SERVICE ROLE KEY uniquement côté serveur. Ne jamais la mettre dans du JS public.
SUPABASE_SERVICE_ROLE_KEY=TON_SERVICE_ROLE_KEY
GHOST_SUPABASE_STATE_TABLE=ghost_app_state
GHOST_STATE_ID=main

# Storage Supabase pour les fichiers élèves/coach
GHOST_STORAGE_BUCKET=ghost-client-files

# Migration automatique du JSON local vers Supabase si la ligne distante n'existe pas
GHOST_AUTO_MIGRATE_LOCAL_JSON=1
# Écrit aussi une copie JSON locale en plus de Supabase, utile au début
GHOST_DUAL_WRITE_JSON=0

# Sécurité coach
GHOST_SECRET_KEY=change-moi-long-et-aleatoire
GHOST_ADMIN_USERNAME=coach
GHOST_ADMIN_PASSWORD=change-moi
